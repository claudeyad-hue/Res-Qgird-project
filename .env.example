VITE_API_BASE_URL=http://localhost:5000
NODE_ENV=development
PORT=5000

# MongoDB Connection String
# Example local: mongodb://localhost:27017/resquard_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/resquard_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/resquard_db

# JWT Configuration
JWT_SECRET=replace-with-a-generated-random-secret
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (comma-separated or single URL)
FRONTEND_URL=http://localhost:5173

# Optional: OpenRouteService (ORS) API Key
# If omitted, system defaults to free OSRM (Open Source Routing Machine) routing
ORS_API_KEY=
VITE_ORS_API_KEY=
